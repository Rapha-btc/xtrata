# Optional: add Hiro API key(s) for local dev + Pages Functions proxy.
# - Local dev: /hiro proxy reads HIRO_API_KEYS (or HIRO_API_KEY fallback).
# - Pages: set runtime secrets; prefer HIRO_API_KEYS for rotation.
# - HIRO_API_KEYS accepts comma/newline separated keys.
# - Optional numbered form also works: HIRO_API_KEY_1, HIRO_API_KEY_2, ...
HIRO_API_KEYS=
HIRO_API_KEY=
VITE_HIRO_API_KEY=

# Optional: override BNS base for /bns proxy + client.
# Recommended for Pages if api.bns.xyz has SSL issues:
# VITE_BNS_API_MAINNET=https://api.mainnet.hiro.so
VITE_BNS_API_MAINNET=
VITE_BNS_API_BASE=

# CSV of uppercase artist wallet addresses allowed to reach the /manage portal.
VITE_ARTIST_ALLOWLIST=

# DoraHacks single-page demo route: /workspace/dora-hacks
# Vite-side values for the demo UI.
VITE_DORA_HACKS_CORE_CONTRACT_ID=
VITE_DORA_HACKS_FREE_ASSET_ID=
VITE_DORA_HACKS_COMMERCE_CONTRACT_ID=
VITE_DORA_HACKS_COMMERCE_LISTING_ID=
# Optional: if omitted, the demo resolves the paid asset ID from the listing.
VITE_DORA_HACKS_COMMERCE_ASSET_ID=
VITE_DORA_HACKS_VAULT_CONTRACT_ID=
VITE_DORA_HACKS_VAULT_ASSET_ID=
# Optional: preloads an existing vault instead of starting from "open vault".
VITE_DORA_HACKS_VAULT_ID=
VITE_DORA_HACKS_VAULT_OPEN_AMOUNT=
VITE_DORA_HACKS_VAULT_DEPOSIT_AMOUNT=
# Must match X402_DEMO_SLUG on the Pages/runtime side.
VITE_DORA_HACKS_X402_SLUG=

# Pages Functions runtime config for the x402 gateway.
# These are not exposed to the browser; set them as local Pages env vars / secrets.
X402_ACCESS_SECRET=
X402_DEMO_SLUG=
X402_DEMO_TITLE=
X402_DEMO_ACCESS_MODE=
X402_DEMO_DELIVERY=
X402_DEMO_CORE_CONTRACT=
X402_DEMO_ASSET_ID=
X402_DEMO_COMMERCE_CONTRACT=
X402_DEMO_LISTING_ID=
X402_DEMO_PRICE=
X402_DEMO_VAULT_CONTRACT=
X402_DEMO_VAULT_ID=
X402_DEMO_MIN_TIER=
