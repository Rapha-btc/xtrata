# Optional: add a Hiro API key for local dev + Pages Functions proxy.
# - For local dev, Vite uses this in the /hiro proxy.
# - For Pages, set HIRO_API_KEY (runtime) and optionally VITE_HIRO_API_KEY (build flag).
HIRO_API_KEY=
VITE_HIRO_API_KEY=

# Optional: override BNS base for /bns proxy + client.
# Recommended for Pages if api.bns.xyz has SSL issues:
# VITE_BNS_API_MAINNET=https://api.mainnet.hiro.so
VITE_BNS_API_MAINNET=
VITE_BNS_API_BASE=
