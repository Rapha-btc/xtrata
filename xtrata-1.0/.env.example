# Optional: add Hiro API key(s) for local dev + Pages Functions proxy.
# - Local dev: /hiro proxy reads HIRO_API_KEYS (or HIRO_API_KEY fallback).
# - Pages: set runtime secrets; prefer HIRO_API_KEYS for rotation.
# - HIRO_API_KEYS accepts comma/newline separated keys.
# - Optional numbered form also works: HIRO_API_KEY_1, HIRO_API_KEY_2, ...
HIRO_API_KEYS=
HIRO_API_KEY=
VITE_HIRO_API_KEY=

# Optional: override BNS base for /bns proxy + client.
# Recommended for Pages if api.bns.xyz has SSL issues:
# VITE_BNS_API_MAINNET=https://api.mainnet.hiro.so
VITE_BNS_API_MAINNET=
VITE_BNS_API_BASE=

# CSV of uppercase artist wallet addresses allowed to reach the /manage portal.
VITE_ARTIST_ALLOWLIST=
