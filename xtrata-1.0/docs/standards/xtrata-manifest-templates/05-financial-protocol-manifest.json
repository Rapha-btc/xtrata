    "canonicalNamespace": "{protocol}.x",
    "canonicalContracts": {
      "router": "SP...router-v1",
      "poolFactory": "SP...factory-v1",
      "feeCollector": "SP...fees-v1",
      "governance": "SP...governance-v1"
    },
    "deployment": {
      "chain": "stacks",
      "network": "mainnet",
      "deployedAtBlock": 0,
      "deploymentTxId": "0x..."
    }
  },
  "assets": {
    "supportedAssets": [
      {
        "symbol": "STX",
        "assetType": "native",
        "contractId": null,
        "decimals": 6,
        "role": "base-asset"
      },
      {
        "symbol": "sBTC",
        "assetType": "sip-010",
        "contractId": "SP...sbtc-token",
        "decimals": 8,
        "role": "quote-asset"
      }
