  "walletAndMarketplaceHints": {
    "displayAs": "financial-protocol",
    "primaryAction": "view-positions",
    "showRiskWarning": true
  },
  "validation": {
    "schemaUri": "schemas/xtrata-financial-protocol-manifest.schema.json",
    "validated": false,
    "validationRules": [
      "schema-valid",
      "contracts-verified",
      "admin-surface-declared",
      "oracle-dependencies-declared"
    ]
  },
  "security": {
    "verifiedContracts": [],
    "verifiedWallets": [],
    "hashes": {
