    "collateralModel": null,
    "interestRateModel": null,
    "rewardModel": null,
    "invariants": [
      "Contract state is canonical for balances and positions.",
      "Manifest describes surfaces and dependencies only."
    ]
  },
  "readOnlySurface": {
    "requiredReadOnlyCalls": [
      "get-pool-info",
      "get-reserves",
      "get-user-position",
      "get-fees",
      "get-admins"
    ],
    "indexerQueries": [
      "positions-by-wallet",
      "volume-by-pool",
      "fee-accruals"
    ]
  },
  "writeSurface": {
    "publicFunctions": [
      "deposit",
      "withdraw",
      "swap",
      "claim-fees"
    ],
    "adminFunctions": [
      "set-fee",
      "pause",
      "resume",
      "set-oracle"
    ],
    "dangerousFunctions": [
      "upgrade-contract",
      "emergency-withdraw"
    ]
  },
  "permissions": {
    "adminPrincipals": [
      {
        "principal": "SP...",
        "role": "protocol-admin",
        "powers": [
          "pause",
          "set-fee"
        ]
      }
    ],
    "upgradeability": {
      "upgradeable": true,
      "method": "governance-timelock",
      "timelockBlocks": 1008
    },
    "emergencyControls": {
      "pausable": true,
      "withdrawalEscapeHatch": false
    }
  },
  "oracles": [
    {
      "oracleId": "primary-price-feed",
      "manifest": "xtrata://inscription/{oracleManifestId}",
      "stalenessPolicySeconds": 3600
