  "namespace": {
    "namespaceId": "x",
    "root": "x",
    "displaySuffix": ".x",
    "type": "xtrata-native",
    "dnsStatus": "not-public-dns-tld",
    "purpose": [
      "human-readable names for Xtrata inscriptions",
      "human-readable names for Xtrata collections",
      "human-readable names for wallets and identities",
      "human-readable names for software/runtime modules",
      "human-readable names for audiovisual works, BVSTs, manifests and composable data objects"
    ],
    "nonGoals": [
      "This manifest does not claim ownership of the public DNS .x top-level domain.",
      "This manifest does not make .x resolve in normal browsers unless a compatible resolver, wallet, gateway, DNS bridge or browser extension is used."
    ],
    "canonicalExamples": [
      "jim.x",
      "dyle.x",
      "froggies.x",
      "song315.x",
      "bvst.x",
      "agent.x"
    ],
    "reservedNamesPolicy": {
      "enabled": true,
      "reservedBy": "xtrata-root-governance",
      "reservedCategories": [
        "protocol",
        "security",
        "marketplace",
        "system",
        "offensive",
        "legal",
        "founder",
        "infrastructure"
      ],
      "reservedNamesManifestUri": "xtrata://inscription/TBD",
      "reservedNamesHash": "sha256:TBD"
    }
  },
  "trustModel": {
    "summary": "The registry contract proves uniqueness and current ownership of a name. The namespace manifest defines the standard. Individual name resolver manifests hold rich records and can point to collection, preservation, marketplace, audiovisual or composable manifests.",
    "uniquenessAuthority": "registry-contract",
    "ownershipAuthority": "registry-contract",
    "richRecordAuthority": "resolver-manifest-or-resolver-contract",
    "historyAuthority": "on-chain-events-plus-inscribed-amendments",
    "recommendedPattern": "registry-contract-proves-owner; resolver-manifest-defines-records; linked-manifests-define-targets",
    "manifestOnlyAllowed": {
      "enabled": true,
      "allowedFor": [
        "local aliases",
        "collection-internal names",
        "fixed preservation aliases",
        "non-canonical display labels"
      ],
      "notAllowedFor": [
        "globally unique .x ownership claims",
        "wallet payment routing",
        "identity verification",
        "marketplace canonical ownership claims"
      ]
    }
  },
  "registry": {
    "requiredForCanonicalNames": true,
    "type": "clarity-contract",
    "contractId": "SP3JNSEXAZP4BDSHV0DN3M8R3P0MY0EEBQQZX743X.xtrata-xns-registry-v1",
    "network": "mainnet",
    "nameNormalization": {
      "case": "lowercase",
      "unicode": "uts46-or-ascii-only-v0",
      "allowedCharacters": "a-z, 0-9, hyphen",
      "minimumLabelLength": 1,
      "maximumLabelLength": 63,
      "maximumFullNameLength": 253,
      "forbiddenPatterns": [
        "leading-hyphen",
        "trailing-hyphen",
        "empty-label",
        "double-dot",
        "unsupported-unicode-confusable"
      ]
    },
    "hashing": {
      "nameHashAlgorithm": "sha256",
      "labelHashAlgorithm": "sha256",
      "nameHashFormula": "nameHash = sha256(normalizedFullName)",
      "labelHashFormula": "labelHash = sha256(normalizedLabel)"
    },
    "registrationModel": {
      "mode": "first-come-first-served-with-reserved-names",
      "paymentAsset": "STX",
      "pricing": {
        "model": "configurable",
        "basePriceMicrostx": "TBD",
        "premiumShortNamePolicy": "optional",
        "renewalPriceMicrostx": "TBD"
      },
      "duration": {
        "model": "configurable",
        "defaultYears": 10,
        "maximumYears": 100,
        "permanentNamesAllowed": true,
        "permanentNamesPolicy": "reserved-or-premium-or-governance-approved"
      },
      "antiSquatting": {
        "commitRevealSupported": true,
        "premiumNamesSupported": true,
        "reservedNamesSupported": true,
        "gracePeriodSupported": true
      }
    },
    "readOnlyInterface": {
      "getOwner": {
        "function": "get-owner",
        "input": "name-hash",
        "returns": "optional principal"
      },
      "getResolver": {
        "function": "get-resolver",
        "input": "name-hash",
        "returns": "optional resolver"
      },
      "getExpiry": {
        "function": "get-expiry",
        "input": "name-hash",
        "returns": "optional uint"
      },
      "getNameRecord": {
        "function": "get-name-record",
        "input": "name-hash",
        "returns": "optional { owner: principal, resolver: optional principal, resolver-uri: optional string-ascii, expiry: optional uint, status: string-ascii }"
      },
      "getReverseName": {
        "function": "get-reverse-name",
        "input": "principal",
        "returns": "optional string-ascii"
      },
      "isNameAvailable": {
        "function": "is-name-available",
        "input": "normalized-name",
        "returns": "bool"
      }
    },
    "publicInterface": {
      "register": {
        "function": "register",
        "inputs": [
          "normalized-name",
          "resolver-uri",
          "duration"
        ],
        "requires": [
          "payment",
          "name-available",
          "not-reserved"
        ]
      },
      "setResolver": {
        "function": "set-resolver",
        "inputs": [
          "name-hash",
          "resolver-uri"
        ],
        "requires": [
          "tx-sender-is-owner"
        ]
      },
      "transfer": {
        "function": "transfer",
        "inputs": [
          "name-hash",
          "new-owner"
        ],
        "requires": [
          "tx-sender-is-owner"
        ]
      },
      "renew": {
        "function": "renew",
        "inputs": [
          "name-hash",
          "duration"
        ],
        "requires": [
          "payment",
          "not-permanent"
        ]
      },
      "setReverseName": {
        "function": "set-reverse-name",
        "inputs": [
          "name-hash"
        ],
        "requires": [
          "tx-sender-is-owner"
        ]
      }
    },
    "events": [
      "name-registered",
      "resolver-updated",
      "name-transferred",
      "name-renewed",
      "name-expired",
      "reverse-name-updated"
    ]
  },
  "resolverStandard": {
