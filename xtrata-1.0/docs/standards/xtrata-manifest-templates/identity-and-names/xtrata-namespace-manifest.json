  "resolution": {
    "algorithmVersion": "0.1.0",
    "defaultResolutionOrder": [
      "normalize name",
      "hash normalized name",
      "query registry get-name-record(nameHash)",
      "verify name exists and is active",
      "verify current owner if ownership is relevant",
      "load resolver URI from registry",
      "fetch resolver manifest from Xtrata",
      "verify resolver manifest hash if supplied by registry",
      "read requested record key from resolver manifest",
      "load any linked target manifest",
      "verify linked target manifest hash",
      "resolve final inscription, collection, runtime or external URL"
    ],
    "pathPatterns": [
      {
        "pattern": "{name}.x",
        "meaning": "resolve primary name record"
      },
      {
        "pattern": "{name}.x/profile",
        "meaning": "resolve profile record"
      },
      {
        "pattern": "{name}.x/avatar",
        "meaning": "resolve avatar record"
      },
      {
        "pattern": "{name}.x/collection",
        "meaning": "resolve canonical collection manifest"
      },
      {
        "pattern": "{name}.x/item/{index}",
        "meaning": "resolve item index through the linked collection manifest"
      },
      {
        "pattern": "{name}.x/runtime",
        "meaning": "resolve runtime or app manifest"
      },
      {
        "pattern": "{subname}.{name}.x",
        "meaning": "resolve delegated subname"
      }
    ],
    "failureModes": [
      {
        "code": "name-not-found",
        "message": "The registry has no active record for this name."
      },
      {
        "code": "name-expired",
        "message": "The registry record exists but has expired."
      },
      {
        "code": "resolver-missing",
        "message": "The name exists but no resolver is set."
      },
      {
        "code": "resolver-hash-mismatch",
        "message": "The fetched resolver manifest does not match the expected hash."
      },
      {
        "code": "target-hash-mismatch",
        "message": "A linked manifest or target inscription failed hash verification."
      }
    ]
  },
