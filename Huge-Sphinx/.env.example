# AIBTC Agent Wallet — Jim's Agent ("Huge Sphinx")
# Registered: 2026-04-09
# 
# SECURITY: This file is in .gitignore and should NEVER be committed to Git.
# Keep these values secure — they control the agent's wallet and identity.
# 
# To set up your environment:
# 1. Copy this file: cp .env.example .env.aibtc
# 2. Fill in the values (or use the backed-up .env.aibtc)
# 3. Ensure .env.aibtc is in .gitignore (it is)

# Agent identity
AIBTC_AGENT_NAME=jim-agent
AIBTC_DISPLAY_NAME="Huge Sphinx"

# Bitcoin (L1) addresses
BTC_ADDRESS=bc1q2knwqf77vp9mhru20hqnrxg00hgzmrpjxxsw0l
BTC_TAPROOT_ADDRESS=bc1p2r7wcxx0kthyvcyw8yv0f0k9jpz2hxt6wn2sz6uspl6f649x8t9sdfpnwe

# Stacks (L2) address
STX_ADDRESS=SP13G0F3E48HDK7MMRYXDHQ4RTACKDN5FSV9VEPRC

# Wallet credentials (KEEP PRIVATE)
WALLET_PASSWORD=<your-wallet-password-here>

# Recovery mnemonic (CRITICAL: store this offline/in a password manager)
